{
  "name": "@hkkimlab/dooray-cli",
  "version": "0.3.0",
  "description": "Dooray CLI (gov-dooray first): drive sync, project/post, wiki, calendar, reservation, messenger, mail",
  "type": "module",
  "bin": {
    "dooray": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hkkimlab/dooray-cli.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "private": false,
  "dependencies": {
    "commander": "^15.0.0",
    "imapflow": "^2.5.5",
    "mailparser": "^3.9.46",
    "nodemailer": "^10.1.7",
    "string-width": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
